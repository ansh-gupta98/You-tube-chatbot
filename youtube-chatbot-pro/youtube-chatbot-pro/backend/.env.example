# =============================================================================
# YouTube Chatbot Pro — Multi-Provider Configuration
# =============================================================================
# Copy this file to ".env" and fill in the keys for the providers you use.
# You only need ONE provider — the others can stay blank.
# =============================================================================

# ---- SERVER ----
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- DEFAULT PROVIDER (which one to use by default) ----
# Options: google | openai | nvidia | groq | anthropic | custom
DEFAULT_LLM_PROVIDER=google
DEFAULT_EMBEDDING_PROVIDER=google

# ---- GOOGLE GEMINI ----
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL=embedding-001

# ---- OPENAI ----
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- NVIDIA NIM (build.nvidia.com) ----
NVIDIA_API_KEY= "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"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embed-v1

# ---- GROQ (free, fast — https://console.groq.com) ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- ANTHROPIC CLAUDE ----
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# ---- CUSTOM (any OpenAI-compatible API) ----
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_LLM_MODEL=

# ---- HUGGINGFACE (free local embeddings fallback) ----
# No key needed — runs locally on your machine
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
